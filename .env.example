# Copy to .env and fill in. Never commit .env.

# --- Production (docker-compose.prod.yml, docs/DEPLOYMENT.md) ---
DOMAIN=localhost                   # public hostname; Caddy gets a certificate for it
BACKUP_PASSPHRASE=                  # long random; encrypts scripts/backup_db.sh dumps

# --- Database (docker compose) ---
POSTGRES_USER=newsdc
POSTGRES_PASSWORD=newsdc            # use a long random value outside local dev
POSTGRES_DB=newsdc
POSTGRES_PORT=5433                  # host port for the dev DB (5433 avoids clashing with a local Postgres)

# SQLAlchemy URL used when running the backend on the host.
# docker compose overrides this to point at the "db" service.
DATABASE_URL=postgresql+psycopg://newsdc:newsdc@localhost:5433/newsdc

# Integration tests only (backend/tests/test_db.py). Must be a THROWAWAY database: its schema is dropped.
# TEST_DATABASE_URL=postgresql+psycopg://newsdc:newsdc@localhost:5433/newsdc_test

# Directory holding categories.yaml and sources.yaml. Default: <repo>/config (/config in containers).
# CONFIG_DIR=

# --- AI provider ---
ANTHROPIC_API_KEY=                  # from console.anthropic.com; required from Phase 3
CLASSIFIER_MODEL=                   # verified Anthropic model ID, e.g. claude-haiku-5-5 (docs/AI_CONFIG.md); no default on purpose
CLASSIFIER_EFFORT=low               # output_config.effort for the classifier; empty = omit (models without effort support)
# USD per million tokens for CLASSIFIER_MODEL, from the provider pricing page. Used for cost estimates and
# the daily limit; 0 = unknown, and then only MAX_LLM_ITEMS_PER_RUN limits spend.
CLASSIFIER_INPUT_USD_PER_MTOK=0     # claude-haiku-5-5: 0.10 (checked 2026-11-09)
CLASSIFIER_OUTPUT_USD_PER_MTOK=0    # claude-haiku-5-5: 0.50 (checked 2026-11-09)
ASSISTANT_MODEL=                    # verified Anthropic model ID for Ask NewsDC, e.g. claude-opus-5-5; empty = /ask returns 503
ASSISTANT_EFFORT=low                # output_config.effort for answers; empty = omit
ASSISTANT_MAX_TOKENS=4000           # hard cap per answer (thinking + text)
ASSISTANT_INPUT_USD_PER_MTOK=0      # cost logging only; claude-opus-5-5: 4.00
ASSISTANT_OUTPUT_USD_PER_MTOK=0     # cost logging only; claude-opus-5-5: 20.00

# --- Security ---
ADMIN_TOKEN=                        # ≥ 16 chars random; admin is disabled while empty (Phase 8)
SESSION_SECRET=                     # ≥ 32 chars random, NOT the admin token; signs the admin cookie
# ADMIN_SESSION_MINUTES=30
CORS_ORIGINS=http://localhost:5173  # comma-separated list of allowed browser origins
RATE_LIMIT_DEFAULT=60/minute        # per client IP on public API routes (`limits` syntax, e.g. 60/minute)
RATE_LIMIT_ASK=10/minute            # extra per-IP limit on POST /api/v1/ask (paid LLM calls)

# --- Pipeline tuning ---
INGEST_INTERVAL_MINUTES=60          # worker schedule interval
RELEVANCE_THRESHOLD=55              # 0-100; min relevance to publish an item
QUALITY_THRESHOLD=40                # 0-100; min quality to publish an item
MAX_LLM_ITEMS_PER_RUN=300           # hard cap on LLM calls per pipeline run
DAILY_LLM_BUDGET_USD=5              # stop starting LLM calls once today's (UTC) estimated spend reaches this
LLM_CONCURRENCY=5                   # items classified in parallel
LLM_TIMEOUT_SECONDS=60              # per LLM request read timeout (SDK retries 429/5xx itself)
NEAR_DUPLICATE_THRESHOLD=0.92       # cosine similarity above which an item is a near-duplicate (14-day window)
SEARCH_MIN_SIMILARITY=0.6           # semantic search drops hits below this cosine similarity
JOB_LEASE_SECONDS=600               # a running job with no heartbeat for this long is reclaimed
# FASTEMBED_CACHE_PATH=             # where the embedding model is cached (compose sets /models for backend and worker)

# --- Sources ---
GITHUB_TOKEN=                       # optional, read-only public-repo token for higher GitHub API limits

# --- Logging ---
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000   # empty in production (same origin behind Caddy)
